# Opción A: Prisma Dev (local, sin Docker)
# 1. Ejecutar: npx prisma dev
# 2. Copiar la URL TCP (puerto 51214) con: npx prisma dev ls
# DIRECT_URL es obligatoria con Prisma Dev. La app la usa en lugar del pooler (51213).
# No hace falta añadir pgbouncer=true manualmente; lib/prisma.ts lo agrega.
DATABASE_URL="prisma+postgres://localhost:51213/?api_key=YOUR_API_KEY"
DIRECT_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"

# Opción B: Docker Compose
# Ejecutar: docker compose up -d
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/test_usabilidad?schema=public"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/test_usabilidad?schema=public"
